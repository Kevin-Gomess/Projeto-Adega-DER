// Projeto Adega - modelo lógico (com chaves estrangeiras)
// Cole em https://dbdiagram.io/d para ver e exportar o diagrama em PNG ou PDF.

Project adega {
  database_type: 'MySQL'
  Note: 'Modelo lógico v1.0 - 23/10/2026. Convenções no Dicionário de Dados, seção 3.'
}

Enum funcionario_tp_cargo {
  ATENDENTE
  GERENTE
}

Enum caixa_st_caixa {
  ABERTO
  FECHADO
}

Enum venda_st_venda {
  CONCLUIDA
  CANCELADA
}

Enum fiado_st_fiado {
  ABERTO
  QUITADO
}

Enum item_venda_tp_item {
  UNIDADE
  DOSE
}

Enum pagamento_tp_forma {
  DINHEIRO
  PIX
  DEBITO
  CREDITO
  FIADO
}

Enum item_fiado_tp_item {
  UNIDADE
  DOSE
}

Enum pagamento_fiado_tp_forma {
  DINHEIRO
  PIX
  DEBITO
  CREDITO
}

Enum fornecedor_tp_fornecimento {
  ENTREGA
  RETIRADA
  AMBOS
}

Enum compra_tp_recebimento {
  ENTREGA
  RETIRADA
}

Enum compra_st_compra {
  PEDIDO
  RECEBIDA
  RECEBIDA_PARCIAL
  CANCELADA
}

Enum movimentacao_estoque_tp_movimento {
  ENTRADA_COMPRA
  SAIDA_VENDA
  SAIDA_DOSE
  PERDA
  DEVOLUCAO_FORNECEDOR
  AJUSTE_ENTRADA
  AJUSTE_SAIDA
}

Enum log_acesso_tp_evento {
  LOGIN
  LOGIN_FALHA
  INSERT
  UPDATE
  DELETE
  CONSULTA_DADO_PESSOAL
  APROVACAO
}

Table categoria {
  id_categoria int [pk, increment, note: 'Identificador da categoria']
  nm_categoria varchar(60) [not null, unique, note: 'Nome da categoria']
  fl_restrita_maiores boolean [not null, default: 0, note: 'Indica se os produtos da categoria só podem ser vendidos a maiores de 18 anos']
  Note: 'Agrupa os produtos da adega e define se a venda é restrita a maiores de 18 anos.'
}

Table produto {
  id_produto int [pk, increment, note: 'Identificador do produto']
  id_categoria int [not null, note: 'Categoria do produto']
  cd_barras varchar(14) [null, unique, note: 'Código de barras (EAN-8, EAN-13 ou EAN-14) lido no balcão']
  nm_produto varchar(100) [not null, note: 'Nome comercial com a medida']
  vl_venda decimal(10,2) [not null, note: 'Preço de venda da unidade fechada']
  fl_vende_dose boolean [not null, default: 0, note: 'Indica se o produto também é vendido em doses']
  qt_ml_garrafa smallint [null, note: 'Volume da garrafa em mililitros']
  qt_ml_dose smallint [null, note: 'Volume de uma dose em mililitros']
  vl_dose decimal(10,2) [null, note: 'Preço de uma dose']
  fl_ativo boolean [not null, default: 1, note: 'Indica se o produto está ativo para venda']

  indexes {
    nm_produto [name: 'idx_produto_nm']
  }
  Note: 'Item comercializado: bebida, cigarro, petisco ou conveniência. Pode ser vendido fechado (unidade) ou em doses.'
}

Table estoque {
  id_estoque int [pk, increment, note: 'Identificador do registro de estoque']
  id_produto int [not null, unique, note: 'Produto controlado']
  qt_atual int [not null, default: 0, note: 'Quantidade atual em unidades']
  qt_minima int [not null, default: 0, note: 'Quantidade mínima antes de repor (ponto de reposição)']
  dt_atualizacao datetime [not null, default: `CURRENT_TIMESTAMP`, note: 'Data e hora da última alteração do saldo']
  Note: 'Saldo atual de cada produto (relação 1:1 com PRODUTO). Só muda por meio de MOVIMENTACAO_ESTOQUE.'
}

Table funcionario {
  id_funcionario int [pk, increment, note: 'Identificador do funcionário']
  nm_funcionario varchar(100) [not null, note: 'Nome completo']
  nr_cpf char(11) [not null, unique, note: 'CPF do funcionário (dado pessoal, LGPD)']
  tp_cargo funcionario_tp_cargo [not null, note: 'Perfil de acesso no sistema']
  ds_login varchar(40) [not null, unique, note: 'Nome de usuário para entrar no sistema']
  ds_senha_hash varchar(255) [not null, note: 'Hash da senha (bcrypt ou argon2)']
  dt_admissao date [not null, note: 'Data de entrada na adega']
  fl_ativo boolean [not null, default: 1, note: 'Indica se o funcionário ainda atua']
  Note: 'Pessoa da equipe (3 a 4 funcionários) que usa o sistema. Perfis: atendente e gerente.'
}

Table escala {
  id_escala int [pk, increment, note: 'Identificador do turno']
  id_funcionario int [not null, note: 'Funcionário escalado']
  dt_turno date [not null, note: 'Dia do turno']
  hr_inicio time [not null, note: 'Hora de início']
  hr_fim time [not null, note: 'Hora de término']
  ds_funcao varchar(40) [not null, note: 'Função exercida no turno']

  indexes {
    dt_turno [name: 'idx_escala_dt']
    (id_funcionario, dt_turno, hr_inicio) [name: 'uq_escala_turno', unique]
  }
  Note: 'Turno de trabalho de um funcionário em um dia, com a função que ele exerce.'
}

Table cliente {
  id_cliente int [pk, increment, note: 'Identificador do cliente']
  nm_cliente varchar(100) [not null, note: 'Nome completo']
  nr_cpf char(11) [not null, unique, note: 'CPF do cliente (dado pessoal, LGPD)']
  dt_nascimento date [not null, note: 'Data de nascimento, para comprovar maioridade']
  nr_telefone varchar(15) [not null, note: 'Telefone com DDD, para cobrança']
  vl_limite_fiado decimal(10,2) [not null, default: 0.00, note: 'Limite de saldo devedor autorizado']
  fl_bloqueado boolean [not null, default: 0, note: 'Indica se o cliente está impedido de comprar fiado']
  dt_consentimento_lgpd datetime [not null, note: 'Momento em que o cliente consentiu o uso dos dados']
  dt_cadastro datetime [not null, default: `CURRENT_TIMESTAMP`, note: 'Data e hora do cadastro']

  indexes {
    nm_cliente [name: 'idx_cliente_nm']
  }
  Note: 'Cliente cadastrado para comprar fiado. Reúne dados pessoais protegidos pela LGPD.'
}

Table caixa {
  id_caixa int [pk, increment, note: 'Identificador da sessão de caixa']
  id_funcionario int [not null, note: 'Funcionário responsável pelo caixa']
  dt_abertura datetime [not null, default: `CURRENT_TIMESTAMP`, note: 'Data e hora de abertura']
  dt_fechamento datetime [null, note: 'Data e hora de fechamento']
  vl_troco_inicial decimal(10,2) [not null, default: 0.00, note: 'Dinheiro de troco colocado na abertura']
  vl_esperado decimal(10,2) [null, note: 'Dinheiro que deveria estar na gaveta no fechamento']
  vl_contado decimal(10,2) [null, note: 'Dinheiro contado fisicamente no fechamento']
  vl_diferenca decimal(10,2) [null, note: 'Diferença entre o contado e o esperado (coluna gerada: vl_contado - vl_esperado)']
  st_caixa caixa_st_caixa [not null, default: 'ABERTO', note: 'Situação da sessão']
  ds_observacao varchar(255) [null, note: 'Justificativa da diferença e registro de sangrias']

  indexes {
    dt_abertura [name: 'idx_caixa_dt']
  }
  Note: 'Sessão de caixa, da abertura ao fechamento, com a conferência do dinheiro.'
}

Table venda {
  id_venda bigint [pk, increment, note: 'Identificador da venda']
  id_funcionario int [not null, note: 'Funcionário que realizou a venda']
  id_caixa int [not null, note: 'Caixa aberto em que a venda foi feita']
  dt_venda datetime [not null, default: `CURRENT_TIMESTAMP`, note: 'Data e hora da venda']
  vl_desconto decimal(10,2) [not null, default: 0.00, note: 'Desconto concedido na venda']
  vl_total decimal(10,2) [not null, note: 'Valor total cobrado']
  st_venda venda_st_venda [not null, default: 'CONCLUIDA', note: 'Situação da venda']
  nr_documento_fiscal varchar(44) [null, note: 'Chave de acesso da NFC-e ou número do cupom fiscal']
  fl_maioridade_conferida boolean [not null, default: 0, note: 'Indica que o atendente conferiu a maioridade do comprador']

  indexes {
    dt_venda [name: 'idx_venda_dt']
  }
  Note: 'Venda feita no balcão, ligada ao funcionário e ao caixa aberto.'
}

Table fiado {
  id_fiado int [pk, increment, note: 'Identificador do fiado']
  id_cliente int [not null, note: 'Cliente devedor']
  dt_abertura datetime [not null, default: `CURRENT_TIMESTAMP`, note: 'Data e hora de abertura da conta']
  dt_vencimento date [not null, note: 'Data limite para pagamento']
  vl_total decimal(10,2) [not null, default: 0.00, note: 'Total lançado na conta']
  vl_pago decimal(10,2) [not null, default: 0.00, note: 'Total já pago']
  st_fiado fiado_st_fiado [not null, default: 'ABERTO', note: 'Situação da conta']

  indexes {
    (id_cliente, st_fiado) [name: 'idx_fiado_cliente_status']
    dt_vencimento [name: 'idx_fiado_venc']
  }
  Note: 'Conta de fiado aberta para um cliente, com prazo e saldo.'
}

Table item_venda {
  id_item_venda bigint [pk, increment, note: 'Identificador do item da venda']
  id_venda bigint [not null, note: 'Venda a que o item pertence']
  id_produto int [not null, note: 'Produto vendido']
  tp_item item_venda_tp_item [not null, default: 'UNIDADE', note: 'Indica se foi vendida a unidade fechada ou uma dose']
  qt_item smallint [not null, note: 'Quantidade vendida']
  vl_unitario decimal(10,2) [not null, note: 'Preço unitário no momento da venda']
  vl_subtotal decimal(12,2) [not null, note: 'Valor do item (coluna gerada: qt_item * vl_unitario)']
  Note: 'Produto vendido em uma venda, com quantidade e preço do momento.'
}

Table pagamento {
  id_pagamento bigint [pk, increment, note: 'Identificador do pagamento']
  id_venda bigint [not null, note: 'Venda paga']
  id_fiado int [null, note: 'Fiado em que a venda foi lançada']
  tp_forma pagamento_tp_forma [not null, note: 'Forma de pagamento']
  vl_pago decimal(10,2) [not null, note: 'Valor pago nesta forma']
  dt_pagamento datetime [not null, default: `CURRENT_TIMESTAMP`, note: 'Data e hora do pagamento']

  indexes {
    (tp_forma, dt_pagamento) [name: 'idx_pagamento_forma']
  }
  Note: 'Forma de pagamento de uma venda. Uma venda pode ter vários pagamentos (pagamento dividido).'
}

Table item_fiado {
  id_item_fiado bigint [pk, increment, note: 'Identificador do item do fiado']
  id_fiado int [not null, note: 'Fiado a que o item pertence']
  id_produto int [not null, note: 'Produto lançado']
  tp_item item_fiado_tp_item [not null, default: 'UNIDADE', note: 'Unidade fechada ou dose']
  qt_item smallint [not null, note: 'Quantidade lançada']
  vl_unitario decimal(10,2) [not null, note: 'Preço unitário no momento do lançamento']
  vl_subtotal decimal(12,2) [not null, note: 'Valor do item (coluna gerada: qt_item * vl_unitario)']
  dt_lancamento datetime [not null, default: `CURRENT_TIMESTAMP`, note: 'Data e hora do lançamento']
  Note: 'Produto lançado em um fiado, com quantidade e preço do momento.'
}

Table pagamento_fiado {
  id_pagamento_fiado bigint [pk, increment, note: 'Identificador do pagamento do fiado']
  id_fiado int [not null, note: 'Fiado abatido']
  id_caixa int [not null, note: 'Caixa que recebeu o valor']
  tp_forma pagamento_fiado_tp_forma [not null, note: 'Forma usada para quitar']
  vl_pago decimal(10,2) [not null, note: 'Valor recebido']
  dt_pagamento datetime [not null, default: `CURRENT_TIMESTAMP`, note: 'Data e hora do recebimento']
  Note: 'Pagamento (total ou parcial) recebido para abater um fiado.'
}

Table fornecedor {
  id_fornecedor int [pk, increment, note: 'Identificador do fornecedor']
  nm_fornecedor varchar(100) [not null, note: 'Razão social ou nome fantasia']
  nr_cnpj char(14) [not null, unique, note: 'CNPJ do fornecedor']
  nr_telefone varchar(15) [null, note: 'Telefone de contato com DDD']
  tp_fornecimento fornecedor_tp_fornecimento [not null, note: 'Como o fornecedor costuma atender']
  fl_ativo boolean [not null, default: 1, note: 'Indica se o fornecedor está ativo']
  Note: 'Empresa que vende mercadoria para a adega, com entrega ou retirada.'
}

Table compra {
  id_compra int [pk, increment, note: 'Identificador da compra']
  id_fornecedor int [not null, note: 'Fornecedor do pedido']
  id_funcionario int [not null, note: 'Funcionário que fez a compra']
  dt_pedido datetime [not null, default: `CURRENT_TIMESTAMP`, note: 'Data e hora do pedido']
  dt_recebimento datetime [null, note: 'Data e hora do recebimento']
  tp_recebimento compra_tp_recebimento [not null, note: 'Como a mercadoria chegou']
  nr_nota_fiscal varchar(44) [null, note: 'Número ou chave da nota fiscal do fornecedor']
  vl_total decimal(12,2) [not null, default: 0.00, note: 'Valor total do pedido']
  st_compra compra_st_compra [not null, default: 'PEDIDO', note: 'Situação da compra']

  indexes {
    dt_pedido [name: 'idx_compra_dt']
  }
  Note: 'Pedido de compra feito a um fornecedor por um funcionário.'
}

Table item_compra {
  id_item_compra int [pk, increment, note: 'Identificador do item da compra']
  id_compra int [not null, note: 'Compra a que o item pertence']
  id_produto int [not null, note: 'Produto pedido']
  qt_pedida int [not null, note: 'Quantidade pedida ao fornecedor']
  qt_recebida int [not null, default: 0, note: 'Quantidade realmente recebida']
  vl_custo decimal(10,2) [not null, note: 'Custo unitário pago ao fornecedor']
  fl_conferido boolean [not null, default: 0, note: 'Indica que o item foi conferido no recebimento']
  ds_divergencia varchar(200) [null, note: 'Descrição de erro, falta ou avaria']

  indexes {
    (id_compra, id_produto) [name: 'uq_item_compra_produto', unique]
  }
  Note: 'Produto pedido em uma compra, com quantidade pedida, recebida e conferência.'
}

Table lote {
  id_lote int [pk, increment, note: 'Identificador do lote']
  id_item_compra int [not null, unique, note: 'Item de compra que originou o lote']
  nr_lote varchar(30) [null, note: 'Número do lote impresso na embalagem']
  dt_validade date [not null, note: 'Data de validade do lote']
  qt_disponivel int [not null, note: 'Quantidade ainda disponível no lote']

  indexes {
    dt_validade [name: 'idx_lote_validade']
  }
  Note: 'Lote recebido de produto com validade. Permite controlar vencimento e vender primeiro o que vence antes.'
}

Table movimentacao_estoque {
  id_movimentacao bigint [pk, increment, note: 'Identificador da movimentação']
  id_produto int [not null, note: 'Produto movimentado']
  id_funcionario int [not null, note: 'Funcionário que registrou']
  id_lote int [null, note: 'Lote atingido, quando houver']
  tp_movimento movimentacao_estoque_tp_movimento [not null, note: 'Tipo da movimentação']
  qt_movimentada int [not null, note: 'Quantidade movimentada, sempre positiva']
  ds_motivo varchar(200) [null, note: 'Motivo da movimentação']
  dt_movimentacao datetime [not null, default: `CURRENT_TIMESTAMP`, note: 'Data e hora da movimentação']

  indexes {
    (id_produto, dt_movimentacao) [name: 'idx_mov_produto_dt']
  }
  Note: 'Histórico de toda entrada e saída de estoque. Não pode ser alterado nem excluído.'
}

Table log_acesso {
  id_log bigint [pk, increment, note: 'Identificador do registro de log']
  id_funcionario int [null, note: 'Funcionário que gerou o evento']
  dt_evento datetime [not null, default: `CURRENT_TIMESTAMP`, note: 'Data e hora do evento']
  tp_evento log_acesso_tp_evento [not null, note: 'Tipo do evento registrado']
  nm_tabela varchar(40) [null, note: 'Tabela atingida']
  id_registro varchar(40) [null, note: 'Identificador do registro atingido']
  ds_alteracao json [null, note: 'Valores antes e depois da alteração']
  ds_ip varchar(45) [null, note: 'Endereço IP de origem']

  indexes {
    dt_evento [name: 'idx_log_dt']
    (nm_tabela, id_registro) [name: 'idx_log_tabela']
  }
  Note: 'Tabela de apoio (fora do DER conceitual) que registra quem fez o quê no sistema, para auditoria e LGPD.'
}

Ref: produto.id_categoria > categoria.id_categoria
Ref: estoque.id_produto - produto.id_produto
Ref: escala.id_funcionario > funcionario.id_funcionario
Ref: caixa.id_funcionario > funcionario.id_funcionario
Ref: venda.id_funcionario > funcionario.id_funcionario
Ref: venda.id_caixa > caixa.id_caixa
Ref: fiado.id_cliente > cliente.id_cliente
Ref: item_venda.id_venda > venda.id_venda
Ref: item_venda.id_produto > produto.id_produto
Ref: pagamento.id_venda > venda.id_venda
Ref: pagamento.id_fiado > fiado.id_fiado
Ref: item_fiado.id_fiado > fiado.id_fiado
Ref: item_fiado.id_produto > produto.id_produto
Ref: pagamento_fiado.id_fiado > fiado.id_fiado
Ref: pagamento_fiado.id_caixa > caixa.id_caixa
Ref: compra.id_fornecedor > fornecedor.id_fornecedor
Ref: compra.id_funcionario > funcionario.id_funcionario
Ref: item_compra.id_compra > compra.id_compra
Ref: item_compra.id_produto > produto.id_produto
Ref: lote.id_item_compra - item_compra.id_item_compra
Ref: movimentacao_estoque.id_produto > produto.id_produto
Ref: movimentacao_estoque.id_funcionario > funcionario.id_funcionario
Ref: movimentacao_estoque.id_lote > lote.id_lote
Ref: log_acesso.id_funcionario > funcionario.id_funcionario
